#!/usr/bin/env python3
"""Delete stale top-level entries of /tmp owned by this user once /tmp gets full.

An entry is stale when nothing inside it was modified, changed or read (mtime/ctime/atime) for AGE_HOURS, nothing inside is a socket or owned by someone else, and no running
process uses it (cwd, root, exe, open file, mapped file or command-line path
under it).
Use is the higher of the filesystem's fill and this user's quota fill (tmpfs
usrquota), since the quota can be full while the filesystem is not. Runs only
while use is at or above START_PCT; deletes oldest first until use drops below
STOP_PCT. At or above URGENT_PCT the idle age drops to URGENT_AGE_HOURS. --dry-run lists what it would delete; --force ignores
the usage thresholds (age and in-use checks still apply).
"""
import os
import shutil
import stat
import subprocess
import sys
import time

TMP = "/tmp"
AGE_HOURS = float(os.environ.get("TMP_AUTOCLEAN_AGE_HOURS", "12"))
START_PCT = float(os.environ.get("TMP_AUTOCLEAN_START_PCT", "50"))
STOP_PCT = float(os.environ.get("TMP_AUTOCLEAN_STOP_PCT", "35"))
URGENT_PCT = float(os.environ.get("TMP_AUTOCLEAN_URGENT_PCT", "80"))
URGENT_AGE_HOURS = float(os.environ.get("TMP_AUTOCLEAN_URGENT_AGE_HOURS", "3"))
SKIP_PREFIXES = ("claude-", "systemd-private-", "tmux-", "ssh-", ".X", ".ICE", ".font", ".XIM", ".Test",
                 "pulse-", "dbus-", "krb5", "snap-private")
UID = os.getuid()


def quota_pct():
    """This user's block-quota fill on /tmp in percent, or 0 if no quota."""
    try:
        out = subprocess.run(["quota", "-w", "-f", TMP], capture_output=True,
                             text=True, timeout=30).stdout.splitlines()
    except (OSError, subprocess.SubprocessError):
        return 0.0
    for line in out[2:]:
        parts = line.split()
        try:
            used = int(parts[1].rstrip("*"))
            limit = int(parts[3]) or int(parts[2])
        except (IndexError, ValueError):
            continue
        if limit:
            return 100.0 * used / limit
    return 0.0


def used_pct():
    st = os.statvfs(TMP)
    return max(100.0 * (1 - st.f_bavail / st.f_blocks), quota_pct())


class Skip(Exception):
    pass


def last_touch(st):
    # Directory and symlink atime are skipped: this scan's own listing and
    # symlink resolution update them.
    if stat.S_ISDIR(st.st_mode) or stat.S_ISLNK(st.st_mode):
        return max(st.st_mtime, st.st_ctime)
    return max(st.st_mtime, st.st_ctime, st.st_atime)


def walk_stats(path):
    """(last touch, size in bytes) of path and everything under it.
    Raises Skip if anything inside is a socket or owned by someone else."""
    st = os.lstat(path)
    newest, total = last_touch(st), st.st_blocks * 512
    if os.path.isdir(path) and not os.path.islink(path):
        for root, dirs, files in os.walk(path, onerror=lambda e: None):
            for name in dirs + files:
                try:
                    s = os.lstat(os.path.join(root, name))
                except OSError:
                    continue
                if s.st_uid != UID or stat.S_ISSOCK(s.st_mode):
                    raise Skip(name)
                newest = max(newest, last_touch(s))
                total += s.st_blocks * 512
    return newest, total


def paths_in_use():
    used = set()
    try:  # bound unix sockets show up in fds only as socket:[inode]
        with open("/proc/net/unix") as f:
            for line in f:
                parts = line.split()
                if len(parts) >= 8 and parts[7].startswith(TMP + "/"):
                    used.add(parts[7])
    except OSError:
        pass
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        base = f"/proc/{pid}"
        try:  # paths named on a command line (waiters, done files) count as used
            with open(f"{base}/cmdline", "rb") as f:
                for arg in f.read().decode(errors="replace").split("\0"):
                    for word in arg.replace("=", " ").replace("'", " ").replace('"', " ").split():
                        if word.startswith(TMP + "/"):
                            used.add(word.rstrip("/"))
        except OSError:
            pass
        for link in ("cwd", "root", "exe"):
            try:
                used.add(os.readlink(f"{base}/{link}"))
            except OSError:
                pass
        try:
            for fd in os.listdir(f"{base}/fd"):
                try:
                    used.add(os.readlink(f"{base}/fd/{fd}"))
                except OSError:
                    pass
        except OSError:
            pass
        try:
            with open(f"{base}/maps") as f:
                for line in f:
                    parts = line.split(None, 5)
                    if len(parts) == 6 and parts[5].startswith(TMP + "/"):
                        used.add(parts[5].strip())
        except OSError:
            pass
    return used


def main():
    dry = "--dry-run" in sys.argv
    force = "--force" in sys.argv
    pct = used_pct()
    age = URGENT_AGE_HOURS if pct >= URGENT_PCT else AGE_HOURS
    print(f"/tmp {pct:.0f}% used (start {START_PCT:.0f}%, stop {STOP_PCT:.0f}%, age {age:g}h)")
    if pct < START_PCT and not force:
        return 0
    cutoff = time.time() - age * 3600
    in_use = paths_in_use()
    candidates = []
    for name in os.listdir(TMP):
        path = os.path.join(TMP, name)
        try:
            st = os.lstat(path)
            if st.st_uid != UID or stat.S_ISSOCK(st.st_mode) or name.startswith(SKIP_PREFIXES):
                continue
            if any(p == path or p.startswith(path + "/") for p in in_use):
                continue
            mtime, size = walk_stats(path)
        except (OSError, Skip):
            continue
        if mtime < cutoff:
            candidates.append((mtime, path, size))
    freed = count = 0
    for mtime, path, size in sorted(candidates):
        if not dry and not force and used_pct() < STOP_PCT:
            break
        try:  # recheck right before deleting; it may have been touched since the scan
            if walk_stats(path)[0] >= cutoff:
                continue
        except (OSError, Skip):
            continue
        if size >= 50 * 2**20:
            print(f"{'would delete' if dry else 'delete'} {path} ({size / 2**20:.0f} MiB, idle {(time.time() - mtime) / 3600:.0f}h)")
        if not dry:
            if os.path.isdir(path) and not os.path.islink(path):
                shutil.rmtree(path, ignore_errors=True)
            else:
                try:
                    os.unlink(path)
                except OSError:
                    pass
        freed += size
        count += 1
    print(f"{'would free' if dry else 'freed'} {freed / 2**30:.1f} GiB in {count} entries; /tmp now {used_pct():.0f}% used")
    return 0


if __name__ == "__main__":
    sys.exit(main())
